<section class="scrollable">
  <ul class="item-list actor-picker">
    {{#each options}}
      <li class="item{{#if (eq ../selected this.uuid)}} picked{{/if}}{{#if this.canPing}} can-ping{{/if}}" data-action="actorPicked" data-document-uuid="{{this.uuid}}">
        <img src="{{this.img}}" width="48" height="48" loading="lazy">
        <span>{{this.name}}</span>
      </li>
    {{/each}}
  </ul>
</section>