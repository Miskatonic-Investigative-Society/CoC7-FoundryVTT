<div class="panel flexcol">
  <h2>{{localize 'CoC7.InvestigatorWizard.TitleAttributes'}}</h2>
  <div class="scrollable flexcol">
    <div class="place-characteristics flexcol">
      {{#each points as |characteristic|}}
        <div class="input-line flexrow">
          <label class="flex-double">{{localize characteristic.label}}</label>
          <div class="not-draggable">{{characteristic.prefix}}{{characteristic.value}}{{characteristic.suffix}}</div>
        </div>
      {{/each}}
    </div>
  </div>
</div>