<div class="panel flexcol">
  <h2>{{localize 'CoC7.InvestigatorWizard.TitleSelectSetup'}}</h2>
  <div class="scrollable flexcol">
    <p>{{localize 'CoC7.InvestigatorWizard.SetupPage'}}</p>
    <div class="form-group">
      <label class="flex-single" for="coc-setup">{{localize 'CoC7.InvestigatorWizard.SetupSelect'}}</label>
      <div class="form-fields">
        <select name="coc-setup">
          <option value="">&nbsp;</option>
          {{selectOptions setupOptions selected=coc7Config.setup}}
        </select>
      </div>
    </div>

    {{#if coc7Config.setup}}
      <div>{{{description}}}</div>
    {{/if}}
  </div>
</div>