<div class="panel flexcol">
  <h2>{{localize 'CoC7.InvestigatorWizard.TitleAdjustCharacteristics'}}</h2>
  <div class="scrollable flexcol">
    {{#unless pulpRuleIgnoreAgePenalties}}
      {{#if coc7Config.requiresAgeAdjustments.edu}}
        {{#if (eq 1 coc7Config.requiresAgeAdjustments.edu.total)}}
          <h5>{{localize 'CoC7.InvestigatorWizard.MakeEDUImprovementCheck' total=coc7Config.requiresAgeAdjustments.edu.total}}</h5>
        {{else}}
          <h5>{{localize 'CoC7.InvestigatorWizard.MakeEDUImprovementChecks' total=coc7Config.requiresAgeAdjustments.edu.total}}</h5>
        {{/if}}
        <div class="place-characteristics flexcol">
          <div class="input-line flexrow">
            <label class="flex-double">{{localize 'CHARAC.Education'}} ({{coc7Config.setupPoints.edu}}%)</label>
            <div class="item-controls"></div>
            <div class="not-draggable">{{points.edu.value}}%</div>
            <div class="item-controls"></div>
          </div>
          <div class="input-line flexrow">
            <div class="flex-double"></div>
            {{#unless coc7Config.requiresAgeAdjustments.edu.rolled}}
              <button class="roll-edu">{{localize 'CoC7.RollDice'}}</button>
            {{/unless}}
            <div class="flex-double"></div>
          </div>
        </div>
      {{/if}}
      {{#if coc7Config.requiresAgeAdjustments.deduct}}
        <h5>{{localize 'CoC7.InvestigatorWizard.DeductPointsFromCharacteristics' total=coc7Config.requiresAgeAdjustments.deduct.total from=deductFrom}}</h5>
        <div class="place-characteristics flexcol">
          {{#each coc7Config.requiresAgeAdjustments.deduct.from as |characteristic|}}
            <div class="input-line flexrow" data-key="{{characteristic}}" data-min="{{lookup (lookup ../points characteristic) 'min'}}" data-max="0">
              <label class="flex-double">{{localize (lookup (lookup ../points characteristic) 'label')}} ({{lookup ../coc7Config.setupPoints characteristic}}%)</label>
              <div class="item-controls">
                <a class="item-control" data-action="modify-characteristic" data-by="-10"><i class="fa-solid fa-angles-down"></i></a>
                <a class="item-control" data-action="modify-characteristic" data-by="-1"><i class="fa-regular fa-minus-circle"></i></a>
              </div>
              <div class="not-draggable">{{lookup (lookup ../points characteristic) 'value'}}% ({{#if (gt (lookup ../coc7Config.setupModifiers characteristic) 0)}}+{{/if}}{{lookup ../coc7Config.setupModifiers characteristic}})</div>
              <div class="item-controls">
                <a class="item-control" data-action="modify-characteristic" data-by="1"><i class="fa-regular fa-plus-circle"></i></a>
                <a class="item-control" data-action="modify-characteristic" data-by="10"><i class="fa-solid fa-angles-up"></i></a>
              </div>
            </div>
          {{/each}}
          <div class="input-line flexrow">
            <label class="flex-double">{{localize 'CoC7.CharacteristicsPoints'}}</label>
            <div class="item-controls">
              <a class="item-control"><i class="fa-solid fa-angles-down"></i></a>
              <a class="item-control"><i class="fa-regular fa-minus-circle"></i></a>
            </div>
            <div class="not-draggable">
              <span class="total">{{deductTotal}}</span>
              <span class="flex-auto">/</span>
              <span class="value">{{coc7Config.requiresAgeAdjustments.deduct.total}}</span>
            </div>
            <div class="item-controls">
              <a class="item-control"><i class="fa-regular fa-plus-circle"></i></a>
              <a class="item-control"><i class="fa-solid fa-angles-up"></i></a>
            </div>
          </div>
        </div>
      {{/if}}
      {{#if coc7Config.requiresAgeAdjustments.reduce}}
        <h5>{{localize 'CoC7.InvestigatorWizard.ReducePointsFromCharacteristic' total=coc7Config.requiresAgeAdjustments.reduce.total from=reduceFrom}}</h5>
        <div class="place-characteristics flexcol">
          <div class="input-line flexrow">
            <label class="flex-double">{{localize (lookup (lookup points coc7Config.requiresAgeAdjustments.reduce.from) 'label')}} ({{lookup coc7Config.setupPoints coc7Config.requiresAgeAdjustments.reduce.from}}%)</label>
            <div class="item-controls">
              <a class="item-control"><i class="fa-solid fa-angles-down"></i></a>
              <a class="item-control"><i class="fa-regular fa-minus-circle"></i></a>
            </div>
            <div class="not-draggable">{{lookup (lookup points coc7Config.requiresAgeAdjustments.reduce.from) 'value'}}%</div>
            <div class="item-controls">
              <a class="item-control"><i class="fa-solid fa-angles-down"></i></a>
              <a class="item-control"><i class="fa-regular fa-minus-circle"></i></a>
            </div>
          </div>
        </div>
      {{/if}}
      {{#if coc7Config.requiresAgeAdjustments.luck}}
        <h5>{{localize 'CoC7.InvestigatorWizard.RollTwiceForLuck'}}</h5>
        <div class="place-characteristics flexcol">
          <div class="input-line flexrow">
            <label class="flex-double">{{localize 'CoC7.Luck'}} ({{coc7Config.setupPoints.luck}}% / {{coc7Config.setupModifiers.luck}}%)</label>
            <div class="item-controls"></div>
            <div class="not-draggable">{{luckValue}}%</div>
            <div class="item-controls"></div>
          </div>
          <div class="input-line flexrow">
            <div class="flex-double"></div>
            {{#unless coc7Config.setupModifiers.luck}}
              <button class="roll-luck">{{localize 'CoC7.RollDice'}}</button>
            {{/unless}}
            <div class="flex-double"></div>
          </div>
        </div>
      {{/if}}
    {{/unless}}
  </div>
</div>