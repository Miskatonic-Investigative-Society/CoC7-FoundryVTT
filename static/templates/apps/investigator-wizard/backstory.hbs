<div class="panel flexcol">
  <h2>{{localize 'CoC7.InvestigatorWizard.TitleBackstory'}}</h2>
  <div class="scrollable flexcol">
    {{#each backstories as |backstory|}}
      <h5>{{localize backstory.name}}</h5>
      <div class="form-group">
        <textarea class="backstory-text" data-index="{{backstory.index}}">{{backstory.value}}</textarea>
      </div>
      <div class="form-group">
        <button class="backstory-reset" data-index="{{backstory.index}}"><i class="fa-solid fa-undo fa-fw"></i> {{localize 'TABLE.ACTIONS.ResetResults'}}</button>
        {{#if backstory.rolls}}
          <button class="backstory-roll" data-index="{{backstory.index}}" data-key="{{backstory.rolls}}"><i class="fa-solid fa-dice-d20 fa-fw"></i> {{localize 'TABLE.ACTIONS.DrawResult'}}</button>
          <button class="backstory-table flex-auto" data-index="{{backstory.index}}" data-key="{{backstory.rolls}}"><i class="fa-solid fa-table-list fa-fw"></i></button>
        {{/if}}
      </div>
    {{/each}}
  </div>
</div>