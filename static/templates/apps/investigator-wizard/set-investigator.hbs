<div class="panel flexcol">
  <h2>{{localize 'CoC7.InvestigatorWizard.TitleDetails'}}</h2>
  <div class="scrollable flexcol">
    <div class="form-group">
      <label class="flex-single" for="name">{{localize 'CoC7.Name'}}</label>
      <div class="form-values">
        <input type="text" class="save-on-blur" name="name" value="{{coc7Config.name}}" required="required">
      </div>
    </div>
    {{#each own as |row key|}}
      <div class="form-group">
        <label class="flex-single" for="{{key}}">{{row.name}}</label>
        <div class="form-values">
          <div class="flexcol own-language-selection">
            {{#if (gt row.options.length 0)}}
              <select class="save-on-change" data-key="{{key}}">
                <option value="">{{row.specialization}}</option>
                {{selectOptions row.options selected=row.selected localize=false}}
              </select>
            {{/if}}
            {{#if (eq row.selected '')}}
              <input type="text" class="save-on-blur" name="{{key}}" value="{{row.value}}" required="required">
            {{/if}}
          </div>
        </div>
      </div>
    {{/each}}
    <div class="form-group">
      <label class="flex-single" for="residence">{{localize 'CoC7.Residence'}}</label>
      <div class="form-values">
        <input type="text" class="save-on-blur" name="residence" value="{{coc7Config.residence}}">
      </div>
    </div>
    <div class="form-group">
      <label class="flex-single" for="birthplace">{{localize 'CoC7.Birthplace'}}</label>
      <div class="form-values">
        <input type="text" class="save-on-blur" name="birthplace" value="{{coc7Config.birthplace}}">
      </div>
    </div>
    <div class="form-group">
      <label class="flex-single" for="avatar">{{localize 'CoC7.InvestigatorWizard.CharacterAvatarImage'}}</label>
      <div class="form-values">
        <file-picker name="avatar" type="image" value="{{coc7Config.avatar}}"></file-picker>
      </div>
    </div>
    <div class="form-group">
      <div></div>
      <div class="investigator-image">
        <img src="{{coc7Config.avatar}}" />
      </div>
    </div>
    <div class="form-group">
      <label class="flex-single" for="token">{{localize 'CoC7.InvestigatorWizard.CharacterTokenImage'}}</label>
      <div class="form-values">
        <file-picker name="token" type="image" value="{{coc7Config.token}}"></file-picker>
      </div>
    </div>
    <div class="form-group">
      <div></div>
      <div class="investigator-image">
        <img src="{{coc7Config.token}}" />
      </div>
    </div>
  </div>
</div>