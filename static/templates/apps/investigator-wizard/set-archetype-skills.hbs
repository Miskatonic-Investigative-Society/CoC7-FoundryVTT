<div class="panel flexcol">
  <h2>{{localize 'CoC7.InvestigatorWizard.TitleArchetypeSkills'}}</h2>
  <div class="scrollable flexcol">
    <div>
      <div>{{localize 'CoC7.InvestigatorWizard.ArchetypeDefaultSkills' count=max}}</div>
      <div class="toggle-group flexcol">
        {{#each skillItems as |skill|}}
          {{#if (eq skill.group 'default')}}
            {{> 'systems/CoC7/templates/apps/investigator-wizard/toggle-skill.hbs' skill=skill toggleKey='archetypeToggle'}}
          {{/if}}
        {{/each}}
      </div>
    </div>
    <div>
      <div>{{localize 'CoC7.InvestigatorWizard.ArchetypeOptionalSkills'}}</div>
      <div class="toggle-group flexcol">
        {{#each skillItems as |skill|}}
          {{#if (eq skill.group 'other')}}
            {{> 'systems/CoC7/templates/apps/investigator-wizard/toggle-skill.hbs' skill=skill toggleKey='archetypeToggle'}}
          {{/if}}
        {{/each}}
      </div>
    </div>
  </div>
  <div class="status-block">
    <div class="form-group status flexrow">
      <div class="icon">{{#if (eq selected max)}}<i class="fa-solid fa-circle-check fa-fw"></i>{{else}}<i class="fa-solid fa-circle-xmark fa-fw"></i>{{/if}}</div>
      <div>{{localize 'CoC7.InvestigatorWizard.SkillSpendArchetypeCountIncorrect' count=selected max=max}}</div>
    </div>
  </div>
</div>