<div class="panel flexcol">
  <h2>{{localize 'CoC7.InvestigatorWizard.TitleSelectOccupation'}}</h2>
  <div class="scrollable flexcol">
    <p>{{localize 'CoC7.InvestigatorWizard.OccupationPage'}}</p>
    <div class="form-group">
      <label class="flex-single" for="coc-occupation">{{localize 'CoC7.InvestigatorWizard.OccupationSelect'}}</label>
      <div class="form-fields">
        <select name="coc-occupation">
          <option value="">&nbsp;</option>
          {{selectOptions occupationOptions selected=coc7Config.occupation}}
        </select>
      </div>
    </div>

    {{#if coc7Config.occupation}}
      <div>
        {{{description}}}
        <div class="form-group">
          <label class="flex-single">{{localize 'CoC7.InvestigatorWizard.OccupationCreditRating'}}</label>
          <div class="form-value">{{creditRating.min}} - {{creditRating.max}}</div>
        </div>
        <div class="form-group">
          <label class="flex-single">{{localize 'CoC7.InvestigatorWizard.OccupationSkillPoints'}}</label>
          <div class="form-value">{{occupationPointsString}}: {{points}}</div>
        </div>

        <div class="form-group">
          <label class="flex-single">{{localize 'CoC7.InvestigatorWizard.OccupationSkills'}}</label>
          <div class="input-line form-value flexcol">
            <div>
              {{#each skills as |skill|}}
                <div>{{skill.name}}</div>
              {{/each}}
            </div>
            {{#each groups as |group|}}
              <div class="form-group">{{localize 'CoC7.InvestigatorWizard.OccupationPickThisMany' count=group.options}}</div>
              <div class="indent-block">
                {{#each group.skills as |set|}}
                  <div>{{set.name}}</div>
                {{/each}}
              </div>
            {{/each}}
            {{#if personal}}
              {{#if personalText}}
                <div>{{personal}} {{personalText}}</div>
              {{else}}
                <div>{{localize 'CoC7.InvestigatorWizard.OccupationPersonalThisMany' count=personal}}</div>
              {{/if}}
            {{/if}}
          </div>
        </div>
      </div>
    {{/if}}
  </div>
</div>