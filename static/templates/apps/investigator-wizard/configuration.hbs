<div class="panel flexcol">
  <h2>{{localize 'CoC7.InvestigatorWizard.TitleKeeperConfiguration'}}</h2>
  <div class="era-change">{{localize 'CoC7.InvestigatorWizard.ChangingEraDelay'}}</div>
  <div class="scrollable flexcol">
    <div class="form-group">
      <div class="form-value toggle-attributes toggle-single-attribute">
        <button class="toggle-switch{{#if coc7Config.defaultQuantity}} switched-on{{/if}}" data-property="default-enabled">{{localize 'CoC7.InvestigatorWizard.PlayerEnabled'}}</button>
      </div>
    </div>
    <div class="form-group">
      <label class="flex-single" for="default-ownership">{{localize 'CoC7.InvestigatorWizard.OtherPlayerOwnership'}}</label>
      <div class="form-fields">
        <select name="default-ownership">
          {{selectOptions ownership selected=coc7Config.defaultOwnership localize=true}}
        </select>
      </div>
    </div>
    <div class="form-group">
      <label class="flex-single" for="world-era">{{localize 'CoC7.Settings.WorldEra.Name'}}</label>
      <div class="form-fields">
        <select name="world-era">
          {{selectOptions _eras selected=coc7Config.defaultEra}}
        </select>
      </div>
    </div>

    <h5>{{localize 'CoC7.InvestigatorWizard.Characteristics'}}</h5>
    <div class="form-group">
      <label class="flex-single">{{localize 'CoC7.Characteristics'}}</label>
      <div class="form-fields toggle-attributes toggle-single-attribute">
        <button class="toggle-switch{{#if coc7Config.rerollsEnabled}} switched-on{{/if}}" data-property="rerolls-enabled">{{localize 'CoC7.InvestigatorWizard.AllowRerolls'}}</button>
      </div>
    </div>
    <div class="form-group">
      <label class="flex-single">{{localize 'CoC7.CharacteristicsPoints'}}</label>
      <div class="form-fields toggle-attributes toggle-button-radio">
        <button class="toggle-switch{{#if (eq characteristicsMethod characteristicsMethods.METHOD_DEFAULT)}} switched-on{{/if}}" data-property="characteristics-method" data-value="{{characteristicsMethods.METHOD_DEFAULT}}">{{localize 'CoC7.InvestigatorWizard.UseSetupMethod'}}</button>
        <button class="toggle-switch{{#if (eq characteristicsMethod characteristicsMethods.METHOD_POINTS)}} switched-on{{/if}}" data-property="characteristics-method" data-value="{{characteristicsMethods.METHOD_POINTS}}">{{localize 'CoC7.InvestigatorWizard.EnforcePointBuy'}}</button>
        <button class="toggle-switch{{#if (eq characteristicsMethod characteristicsMethods.METHOD_VALUES)}} switched-on{{/if}}" data-property="characteristics-method" data-value="{{characteristicsMethods.METHOD_VALUES}}">{{localize 'CoC7.InvestigatorWizard.QuickFireValues'}}</button>
        <button class="toggle-switch{{#if (eq characteristicsMethod characteristicsMethods.METHOD_CHOOSE)}} switched-on{{/if}}" data-property="characteristics-method" data-value="{{characteristicsMethods.METHOD_CHOOSE}}">{{localize 'CoC7.InvestigatorWizard.ChooseAfterRoll'}}</button>
      </div>
    </div>
    {{#if coc7Config.quickFireValues.length}}
      <div class="form-group">
        <label class="flex-single">{{localize 'CoC7.InvestigatorWizard.QuickFireValues'}}</label>
        <div class="form-fields quick-fire-values">
          {{#each coc7Config.quickFireValues as |value offset|}}
            <input type="number" name="quick-fire-values-{{offset}}" value="{{value}}">
          {{/each}}
        </div>
      </div>
    {{/if}}

    <h5>{{localize 'CoC7.InvestigatorWizard.Setups'}}</h5>
    <p>{{localize 'CoC7.InvestigatorWizard.SetupCounts' count=setups.length}}</p>
    <div class="form-group">
      <label class="flex-single" for="default-setup">{{localize 'CoC7.InvestigatorWizard.SetupSelect'}}</label>
      <div class="form-fields">
        <select name="default-setup">
          <option value="">{{localize 'CoC7.InvestigatorWizard.SetupAny'}}</option>
          {{selectOptions setupOptions selected=coc7Config.defaultSetup}}
        </select>
      </div>
    </div>

    {{#if coc7Config.defaultSetup}}
      {{{description}}}
    {{/if}}

    <h5>{{localize 'CoC7.InvestigatorWizard.Occupations'}}</h5>
    <p>{{localize 'CoC7.InvestigatorWizard.OccupationCounts' count=occupations.length}}</p>

    {{#if hasArchetypes}}
      <h5>{{localize 'CoC7.InvestigatorWizard.Archetypes'}}</h5>
      <p>{{localize 'CoC7.InvestigatorWizard.ArchetypeCounts' count=archetypes.length}}</p>
    {{/if}}
  </div>
</div>