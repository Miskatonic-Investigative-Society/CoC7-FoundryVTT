<section class="tab flexcol filled-box no-tabs active">
  <div class="flexrow flex-single tall-columns">
    <div class="properties-list">
      {{#each _properties}}
        <div class="property">{{localize this}}</div>
      {{/each}}
    </div>
    <fieldset class="flexcol flex-single">
      <div class="prosemirror flex-single">
        <div class="editor-content">{{{enrichedDescriptionValue}}}</div>
      </div>
    </fieldset>
  </div>
</section>