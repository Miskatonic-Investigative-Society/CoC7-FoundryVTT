<section>
  <p>{{localize 'CoC7.SanityLossTypeDialogBody'}}</p>
  <div class="form-group">
    <label class="flex-single">{{localize 'CoC7.SanityLossType'}}</label>
    <select name="type">
      {{selectOptions encounterTypes selected=type localize=true}}
    </select>
  </div>
  <div class="form-group">
    <label class="flex-single">{{localize 'CoC7.SanityLossTypeReason'}}</label>
    <input type="text" name="name" value="{{name}}" />
  </div>
  {{#unless isImmunity}}
    <div class="form-group">
      <label class="flex-single">{{localize 'CoC7.SanityLossTypeValue'}}</label>
      <input type="number" name="value" value="{{value}}" />
    </div>
  {{/unless}}
</section>