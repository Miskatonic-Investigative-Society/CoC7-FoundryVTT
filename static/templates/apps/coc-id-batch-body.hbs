<section class="flexcol tab scrollable">
  <ul class="item-list">
    <li class="items-header">
      <div class="flex-single">{{typeName}}</div>
      <div class="flex-double">{{localize 'CoC7.CoCIDFlag.key'}}</div>
      <div class="item-controls">
        <a class="item-control" data-action="guess-toggle" data-tooltip="CoC7.CoCIDFlag.guess"><i class="fa-solid fa-wand-magic fa-fw"></i></a>
      </div>
    </li>
    {{#each missingNames as |row|}}
      <li class="item" data-name="{{row.name}}">
        <div class="flex-single">{{row.name}}</div>
        <div class="flex-single">
          <select class="existing">
            <option value="">{{localize 'CoC7.CoCIDFlag.new'}}</option>
            {{selectOptions ../foundKeys selected=row.custom valueAttr="key" labelAttr="name"}}
          </select>
        </div>
        <div class="flexrow flex-single">
          {{#if row.key}}
            <label>{{row.custom}}</label>
          {{else}}
            <label>{{../idPrefix}}</label>
            <input type="text" class="flex-single" value="{{row.suffix}}">
          {{/if}}
        </div>
        <div class="item-controls">
            <a class="item-control"{{#unless row.key}} data-action="guess-id" data-tooltip="CoC7.CoCIDFlag.guess"{{/unless}}><i class="fa-solid fa-wand-magic fa-fw"></i></a>
        </div>
      </li>
    {{/each}}
  </ul>
</section>