<section class="tab active">
  <span class="coc7-warning"><i class="fa-solid fa-exclamation-triangle"></i> {{localize 'CoC7.CoCIDCompendiumPopulateWarning'}}</span>
  {{#if (gt coc7Config.packLists.length 0)}}
    <div class="form-group">
      <label class="flex-single">{{localize 'CoC7.CoCIDCompendiumPopulateDestination'}}</label>
      <div class="form-value">
        <select name="pack">
          {{selectOptions coc7Config.packLists selected=coc7Config.packList}}
        </select>
      </div>
    </div>
    <div class="form-group">
      <label class="flex-single">{{localize 'CoC7.CoCIDCompendiumPopulateTypes'}}</label>
      <div class="toggle-attributes form-value flexrow">
        {{#each coc7Config.types as |row|}}
          <button class="toggle-switch{{#if row.isEnabled}} switched-on{{/if}}" data-property="{{row.value}}"{{#if row.tooltip}} data-tooltip="{{row.tooltip}}"{{/if}}>{{row.label}}</button>
        {{/each}}
      </div>
    </div>
  {{else}}
    <div class="form-group">
      <div class="form-value">
        {{localize 'CoC7.CoCIDCompendiumPopulateMissing'}}
      </div>
    </div>
  {{/if}}
</section>