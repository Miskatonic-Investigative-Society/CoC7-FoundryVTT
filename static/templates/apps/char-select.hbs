<section class="standard-form">
  <ul class="item-list">
    {{#each characteristics as |characteristic|}}
      <li class="item single-item">
        <div class="item-controls">
          <a class="item-control" data-action="selectable" data-key="{{characteristic.key}}">{{localize characteristic.label}} {{#if characteristic.value}}({{characteristic.value}}){{/if}}</a>
        </div>
      </li>
    {{/each}}
  </ul>
</section>