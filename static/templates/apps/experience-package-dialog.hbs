<section class="standard-form scrollable">
  {{#if (or isCthulhuGain isSanityLoss)}}
    <fieldset class="closer">
      {{#if isCthulhuGain}}
        <div class="form-group">
          <label class="flex-double">{{localize 'CoC7.MythosGain'}}</label>
          <div class="form-fields">
            <input type="text" name="cthulhuGain" value="{{cthulhuGain}}" placeholder="{{localize 'CoC7.MythosGain'}}"{{#if rolledCthulhu}} disabled{{/if}} />
          </div>
        </div>
      {{/if}}
      {{#if isSanityLoss}}
        <div class="form-group">
          <label class="flex-double">{{localize 'CoC7.SANLoss'}}</label>
          <div class="form-fields">
            <input type="text" name="sanityLoss" value="{{sanityLoss}}" placeholder="{{localize 'CoC7.SANLoss'}}"{{#if rolledSan}} disabled{{/if}} />
          </div>
        </div>
      {{/if}}
      <div class="form-group">
        <label class="flex-double"></label>
        <div class="form-fields">
          {{#if (and (ne rolledCthulhu false) (ne rolledSan false) (eq isSanitySame false))}}
            <div class="coc7-no-button">{{rolledCthulhu}} / {{rolledSan}}</div>
          {{else if (ne rolledCthulhu false)}}
            <div class="coc7-no-button">{{rolledCthulhu}}</div>
          {{else if (ne rolledSan false)}}
            <div class="coc7-no-button">{{rolledSan}}</div>
          {{else}}
            <button class="flex-single" data-action="roll">{{localize 'CoC7.RollDice'}}</button>
          {{/if}}
        </div>
      </div>
    </fieldset>
  {{/if}}
  {{#if addSpells}}
    <fieldset class="flexcol drop-item flex-single">
      <legend>{{localize 'CoC7.ExperiencePackageSpellList'}}</legend>
      <ul class="item-list">
        {{#unless spells.length}}
          <li class="item">
            <label>{{localize 'CoC7.EmptySpellList'}}</label>
          </li>
        {{else}}
          {{#each spells as |item|}}
            <li class="item" data-item-id="{{item._id}}" data-type="spell">
              <div class="summary">{{item.name}}</div>
              <div class="item-controls">
                <a class="item-control" data-action="item-delete" data-tooltip="CoC7.DeleteItem"><i class="fa-solid fa-trash fa-fw"></i></a>
              </div>
            </li>
          {{/each}}
        {{/unless}}
      </ul>
    </fieldset>
  {{/if}}
  {{#each backstory as |type index|}}
    <fieldset>
      <legend class="flexrow">
        {{localize 'CoC7.InvestigatorWizard.TitleBackstory'}}
        <select data-backstory-index="{{index}}">
          <option value="">&nbsp;</option>
          {{selectOptions ../backstoryOptions selected=type.type localize=true}}
        </select>
      </legend>
      <div class="flexcol drop-item backstoryBlock" data-index="{{index}}">
        {{#if (eq type.type 'CoC7.PromptAddInjuryScar')}}
          <textarea class="flex-single">{{type.value}}</textarea>
        {{else if (eq type.type 'CoC7.PromptAddStatus')}}
          <ul class="item-list">
            {{#unless type.value}}
              <li class="item">
                <label>{{localize 'CoC7.EmptyStatusList'}}</label>
              </li>
            {{else}}
              <li class="item" data-item-id="{{type.value._id}}" data-type="status">
                <div class="summary">{{type.value.name}}</div>
                <div class="item-controls">
                  <a class="item-control" data-action="item-delete" data-tooltip="CoC7.DeleteItem"><i class="fa-solid fa-trash fa-fw"></i></a>
                </div>
              </li>
            {{/unless}}
          </ul>
        {{else if (eq type.type 'CoC7.AddSanityLossEncounter')}}
          <div class="form-group">
            <label class="flex-single">{{localize 'CoC7.SanityLossTypeReason'}}</label>
            <div class="form-fields">
              <input type="text" value="{{type.value.reason}}" data-name="reason" />
            </div>
          </div>
          <div class="form-group">
            <label class="flex-single">{{localize 'CoC7.SanityLossTypeValue'}}</label>
            <div class="form-fields">
              <input type="number" value="{{type.value.points}}" data-name="points">
            </div>
          </div>
          <div class="form-group">
            <label class="flex-single">{{localize 'CoC7.ExperiencePackageApplySanity'}}</label>
            <div class="form-fields toggle-attributes toggle-single-attribute">
              <button class="item-control toggle-switch{{#if type.value.apply}} switched-on{{/if}}" data-action="toggle-switch" data-toggle="{{index}}">{{localize 'CoC7.ExperiencePackageApplySanity'}}</button>
            </div>
          </div>
        {{/if}}
      </div>
    </fieldset>
  {{/each}}
</section>