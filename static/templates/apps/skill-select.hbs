<section class="standard-form scrollable">
  <ul class="item-list">
    <li class="item single-item">
      <label class="flex-auto">{{localize 'CoC7.Chosen'}}</label>
      <span class="flex-auto">{{selectedCount}}/{{optionsCount}}</span>
    </li>
    {{#each skills as |skill|}}
      <li class="item">
        <label>{{skill.name}} ({{skill.system.base}}%)</label>
        <div class="item-controls">
          {{#unless (lookup ../selected skill.id)}}<a class="item-control" data-action="skill-select" data-id="{{skill.id}}"><i class="fa-regular fa-plus-circle fa-fw"></i></a>{{/unless}}
        </div>
      </li>
    {{/each}}
  </ul>
</section>