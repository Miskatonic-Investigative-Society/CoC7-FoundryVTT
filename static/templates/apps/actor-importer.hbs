<section class="tab active">
  {{#if (eq importType 'dholehouse')}}
    <div>{{localize 'CoC7.DholeHouseActorImporterSummary'}}</div>
    {{#unless canUpload}}
      <div class="error">{{localize 'CoC7.UnableToUploadDholeImage'}}</div>
    {{/unless}}
  {{else}}
    <div>{{localize 'CoC7.ActorImporterSummary'}}</div>
  {{/if}}
  <div class="form-group">
    <label for="coc-entity-type" class="flex-double">{{localize 'CoC7.SelectActorType'}}:</label>
    <div class="form-value">
      <select id="coc-entity-type" name="coc-entity-type">
        {{selectOptions importTypeOptions selected=importType localize=true}}
      </select>
    </div>
  </div>
  {{#if (or (eq importType 'npc') (eq importType 'creature'))}}
    <div class="form-group">
      <label for="coc-convert-6E" class="flex-double">{{localize 'CoC7.ConvertFrom6Edition'}}:</label>
      <div class="form-value">
        <select id="coc-convert-6E" name="coc-convert-6E">
          {{selectOptions convert6EOptions selected=convert6E localize=true}}
        </select>
      </div>
    </div>
    <div class="form-group">
      <label for="coc-entity-lang" class="flex-double">{{localize 'CoC7.SelectSourceLanguage'}}:</label>
      <div class="form-value">
        <select id="coc-entity-lang" name="coc-entity-lang">
          {{selectOptions languages selected=language localize=true}}
        </select>
      </div>
    </div>
  {{/if}}
  <div class="form-group">
    <label for="source" class="flex-double">{{localize 'CoC7.ImportSkillItemLocations'}}:</label>
    <div class="form-value">
      <select id="source" name="source">
        {{selectOptions sourceOptions selected=source localize=true}}
      </select>
    </div>
  </div>
  {{#if (eq importType 'dholehouse')}}
    <div class="form-group">
      <label for="dholehouse-json-file-picker" class="flex-triple">{{localize 'CoC7.DholeHousePickYourJSONFile'}}</label>
      <div class="form-value">
        <input id="dholehouse-json-file-picker" name="dholehouse-json-file-picker" type="file" accept="application/json" />
      </div>
    </div>
    <div id="coc-prompt"></div>
    {{#if (and characterName characterImage)}}
      <div class="form-group form-baseline">
        <label class="flex-auto">{{localize 'CoC7.DholeHouseImportingName'}}</label>
        <div class="form-value">
          <div>{{characterName}}</div>
          <div><img id="dholehouse-character-portrait" src="{{characterImage}}" /></div>
        </div>
      </div>
    {{/if}}
  {{else}}
    <div id="coc-prompt" data-text="{{localize 'CoC7.PasteTheDataBelow'}}">{{localize 'CoC7.PasteTheDataBelow'}}</div>
    <div class="form-group">
      <textarea id="coc-pasted-character-data" name="coc-pasted-character-data" placeholder="{{placeholder}}">{{characterData}}</textarea>
    </div>
  {{/if}}
</section>