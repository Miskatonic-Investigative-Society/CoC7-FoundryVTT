<section class="standard-form">
  <ul class="item-list adjustable-inputs">
    {{#each characteristics as |characteristic key|}}
      <li class="item" data-key="{{key}}">
        <label class="flex-double">{{localize characteristic.label}}{{#if ../isRolls}} - {{characteristic.formula}}{{/if}}</label>
        {{#unless ../isRolls}}
          <div class="item-controls">
            <a class="item-control" data-action="decrease-characteristic"><i class="fa-regular fa-minus-circle fa-fw"></i></a>
          </div>
        {{/unless}}
        <input type="text" name="{{key}}" value="{{lookup ../values key}}" placeholder="{{localize 'CoC7.Value'}}" />
        {{#if ../isRolls}}
          <div class="item-controls">
            <a class="item-control" data-action="roll-characteristic"><i class="fa-solid fa-dice fa-fw"></i></a>
          </div>
        {{else}}
          <div class="item-controls">
            <a class="item-control" data-action="increase-characteristic"><i class="fa-regular fa-plus-circle fa-fw"></i></a>
          </div>
        {{/if}}
      </li>
    {{/each}}
    <li class="item" data-key="luck">
      <label class="flex-double">{{localize luck.label}} - {{luck.formula}}</label>
      {{#unless isRolls}}
        <div class="item-controls">
          <a class="item-control" data-action="reset-characteristic"><i class="fa-solid fa-eraser fa-fw"></i></a>
        </div>
      {{/unless}}
      <input type="text" name="luck" value="{{lookup values 'luck'}}" placeholder="{{localize 'CoC7.Value'}}" />
      <div class="item-controls">
        <a class="item-control" data-action="roll-characteristic"><i class="fa-solid fa-dice fa-fw"></i></a>
      </div>
    </li>
  </ul>
  {{#if isPoints}}
    <div class="points-summary{{#if pointsWarning}} coc7-warning{{/if}}">
      <label>{{localize 'CoC7.CharacteristicsPoints'}}</label>
      <span class="points-count total-points">{{totalPoints}}</span>
      <label>/</label>
      <span class="points-count">{{points}}</span>
    </div>
  {{else if isRolls}}
    <div class="points-summary{{#if pointsWarning}} coc7-warning{{/if}}">
      <label>{{localize 'CoC7.CharacteristicsPoints'}}</label>
      <span class="points-count total-points">{{totalPoints}}</span>
    </div>
  {{/if}}
</section>