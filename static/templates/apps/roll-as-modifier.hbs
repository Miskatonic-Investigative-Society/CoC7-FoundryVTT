<section>
  <div class="form-group">
    <label class="flex-single">{{localize 'CoC7.RollAsModifier.Modifier.Title'}}</label>
    <div class="toggle-attributes form-value flexrow">
      {{#each _modifier as |row|}}
        <button class="toggle-switch{{#if row.isEnabled}} switched-on{{/if}}" data-set="modifier" data-property="{{row.value}}"{{#if row.tooltip}} data-tooltip="{{row.tooltip}}"{{/if}}>{{row.label}}</button>
      {{/each}}
    </div>
  </div>
  <div class="form-group">
    <label class="flex-single">{{localize 'CoC7.RollAsModifier.Type.Title'}}</label>
    <div class="toggle-attributes form-value flexrow">
      {{#each _type as |row|}}
        <button class="toggle-switch{{#if row.isEnabled}} switched-on{{/if}}" data-set="type" data-property="{{row.value}}"{{#if row.tooltip}} data-tooltip="{{row.tooltip}}"{{/if}}>{{row.label}}</button>
      {{/each}}
    </div>
  </div>
  <div class="form-group">
    <label class="flex-single">{{localize 'CoC7.RollAsModifier.ActiveEffect.Title'}}</label>
    <div class="toggle-attributes form-value flexrow">
      {{#each _activeEffect as |row|}}
        <button class="toggle-switch{{#if row.isEnabled}} switched-on{{/if}}" data-set="activeEffect" data-property="{{row.value}}"{{#if row.tooltip}} data-tooltip="{{row.tooltip}}"{{/if}}>{{row.label}}</button>
      {{/each}}
    </div>
  </div>
  <div class="form-group">
    <label class="flex-single">{{localize 'CoC7.RollAsModifier.Value'}}</label>
    <div class="form-value">
      <select name="value">
        {{selectOptions _values selected=value localize=true}}
      </select>
    </div>
  </div>
</section>