<section class="standard-form">
  <ul class="item-list">
    <li class="item single-item">
      <label class="flex-auto">{{localize 'CoC7.SkillTotalOccupation'}}</label>
      <span class="flex-auto">{{total}}</span>
    </li>
    {{#each characteristicOptional as |characteristic|}}
      <li class="item single-item">
        <div class="item-controls">
          <a class="item-control{{#if (eq ../selected characteristic.key)}} selected{{/if}}" data-action="selectable" data-key="{{characteristic.key}}">{{localize characteristic.label}} ({{characteristic.value}}x{{characteristic.multiplier}}:{{characteristic.total}})</a>
        </div>
      </li>
    {{/each}}
    {{#each characteristicFixed as |characteristic|}}
      <li class="item single-item">
        <div class="item-controls">
          <div class="selected">{{localize characteristic.label}} ({{characteristic.value}}x{{characteristic.multiplier}}:{{characteristic.total}})</div>
        </div>
      </li>
    {{/each}}
  </div>
</section>