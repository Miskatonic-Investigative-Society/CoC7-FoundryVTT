<section class="tab active">
  <span class="coc7-warning"><i class="fa-solid fa-exclamation-triangle"></i> {{localize 'CoC7.ActorCoCIDItemsWarning'}}</span>
  <p>{{localize 'CoC7.ActorCoCIDItemsWhich'}}</p>
  <ul class="without-margin">
    <li>{{localize 'CoC7.ActorCoCIDItemsRules1' era=era}}</li>
    {{#unless isEn}}
      <li>{{localize 'CoC7.ActorCoCIDItemsRules2' lang=lang}}</li>
    {{/unless}}
    <li>{{localize 'CoC7.ActorCoCIDItemsRules3'}}</li>
  </ul>
  <div class="form-group">
    <div class="toggle-attributes form-value flexcol">
      <div><button class="toggle-switch{{#if coc7Config.unlinked}} switched-on{{/if}}" data-property="unlinked">{{localize 'CoC7.ActorCoCIDItemsUnlinkedToken'}}</button></div>
      <div><button class="toggle-switch{{#if coc7Config.anySkills}} switched-on{{/if}}" data-property="anySkills">{{localize 'CoC7.ActorCoCIDItemsAny'}}</button></div>
    </div>
  </div>
  <div class="form-group">
    <div class="toggle-attributes form-value flexrow">
      <button class="toggle-switch{{#if (eq coc7Config.which Which.SceneTokens)}} switched-on{{/if}}" data-property="which" data-value="{{Which.SceneTokens}}">{{localize 'CoC7.ActorCoCIDItemsSceneTokens'}}</button>
      <button class="toggle-switch{{#if (eq coc7Config.which Which.ActorSheets)}} switched-on{{/if}}" data-property="which" data-value="{{Which.ActorSheets}}">{{localize 'CoC7.ActorCoCIDItemsActorSheets'}}</button>
      <button class="toggle-switch{{#if (eq coc7Config.which Which.ActorDirectory)}} switched-on{{/if}}" data-property="which" data-value="{{Which.ActorDirectory}}">{{localize 'CoC7.ActorCoCIDItemsActorDirectory'}}</button>
    </div>
  </div>
</section>