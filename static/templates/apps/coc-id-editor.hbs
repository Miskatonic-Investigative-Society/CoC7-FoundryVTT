<section class="tab scrollable active">
  <input type="hidden" name="id" value="{{id}}">
  <div class="form-group">
    <div>{{{localize 'CoC7.CoCIDFlag.summary' type=object.type}}}</div>
  </div>
  <div class="form-group">
    <label for="_existing">{{localize 'CoC7.CoCIDFlag.key'}}:</label>
    <div class="form-value flex-row-gapped">
      {{#if existingKeys.length}}
        <select name="known">
          <option value="">{{localize 'CoC7.CoCIDFlag.new'}}</option>
          {{selectOptions existingKeys selected=id localize=false}}
        </select>
      {{else}}
        <span class="flex-auto">{{idPrefix}}</span>
        <input type="text" name="_existing" value="{{_existing}}" data-prefix="{{idPrefix}}">
      {{/if}}
      {{#if editable}}
        <span class="flex-auto">
          <a class="control" data-tooltip="CoC7.CoCIDFlag.guess" data-guess="{{guessCode}}"><i class="fa-solid fa-wand-magic"></i></a>
        </span>
      {{/if}}
    </div>
  </div>
  {{#if (and existingKeys.length (not isSystemID))}}
    <div class="form-group">
      <label>&nbsp;</label>
      <div class="flexrow form-value">
        <span class="flex-auto">{{idPrefix}}</span>
        <input type="text" name="_existing" value="{{_existing}}" data-prefix="{{idPrefix}}">
      </div>
    </div>
  {{/if}}
  <div class="form-group">
    <label for="lang">{{localize 'CoC7.language'}}:</label>
    <div class="form-value">
      <select name="lang">
        {{selectOptions supportedLanguages selected=lang localize=false}}
      </select>
    </div>
  </div>
  <div class="form-group toggle-row">
    <label>{{localize 'CoC7.Eras'}}:</label>
    <div class="form-value toggle-attributes toggle-smaller flexrow" data-set="eras">
      {{#each _eras as |row|}}
        <button class="toggle-switch{{#if ../useEraIcons}} as-icon{{/if}}{{#if row.isEnabled}} switched-on{{/if}}" data-property="{{row.value}}"{{#if ../useEraIcons}} data-tooltip="{{row.label}}"{{/if}}>{{#if ../useEraIcons}}<i class="{{row.icon}}"></i>{{else}}{{row.label}}{{/if}}</button>
      {{/each}}
    </div>
  </div>
  <div class="form-group">
    <label for="priority">{{localize 'CoC7.CoCIDFlag.priority'}}:</label>
    <div class="form-value">
      <input class="short-number" type="number" name="priority" value="{{priority}}">
    </div>
  </div>
  <fieldset class="flexcol form-gapped">
    <legend>{{localize 'CoC7.CoCIDFlag.info'}}</legend>
    <label>{{localize 'CoC7.CoCIDFlag.others'}}:</label>
    <div class="flexcol">
      <details>
        <summary>{{localize 'CoC7.CoCIDFlag.documents-in-world' count=worldDuplicates}}{{#if warnDuplicateWorldPriority}} <span class="coc7-warning"><i class="fa-solid fa-exclamation-triangle"></i>{{localize 'CoC7.CoCIDFlag.error.duplicate'}}</span>{{/if}}</summary>
        <table>
          <thead>
            <tr>
              {{#each usedEras as |era|}}
                <td class="flex-auto padding-small"><i class="{{era.icon}}" data-tooltip="{{era.label}}"></i></td>
              {{/each}}
              <td class="padding-small">{{localize 'CoC7.CoCIDFlag.priority-short'}}</td>
              <td class="padding-small">{{localize 'CoC7.language'}}</td>
              <td class="padding-small">{{localize 'DOCUMENT.Document'}}</td>
              <td class="padding-small">{{localize 'DOCUMENT.Folder'}}</td>
            </tr>
          </thead>
          <tbody>
            {{#each worldDocumentInfo}}
              <tr>
                {{#each ../usedEras as |era|}}
                  <td class="flex-auto padding-small">
                    {{#if (lookup ../eras era.value)}}
                      <i class="fa-solid fa-circle" data-tooltip="{{era.label}}"></i>
                    {{else}}
                      <i class="fa-regular fa-circle" data-tooltip="{{era.label}}"></i>
                    {{/if}}
                  </td>
                {{/each}}
                <td class="padding-small">{{priority}}</td>
                <td class="padding-small">{{lang}}</td>
                <td class="padding-small">{{{link}}}</td>
                <td class="padding-small">{{{folder}}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </details>
      <details>
        <summary>{{localize 'CoC7.CoCIDFlag.documents-in-compendiums' count=compendiumDuplicates}}{{#if warnDuplicateCompendiumPriority}} <span class="coc7-warning"><i class="fa-solid fa-exclamation-triangle"></i>{{localize 'CoC7.CoCIDFlag.error.duplicate'}}</span>{{/if}}</summary>
        <table>
          <thead>
            <tr>
              {{#each usedEras as |era|}}
                <td class="flex-auto padding-small"><i class="{{era.icon}}" data-tooltip="{{era.label}}"></i></td>
              {{/each}}
              <td class="padding-small">{{localize 'CoC7.CoCIDFlag.priority-short'}}</td>
              <td class="padding-small">{{localize 'CoC7.language'}}</td>
              <td class="padding-small">{{localize 'DOCUMENT.Document'}}</td>
              <td class="padding-small">{{localize 'COMPENDIUM.Name'}}</td>
            </tr>
          </thead>
          <tbody>
            {{#each compendiumDocumentInfo}}
              <tr>
                {{#each ../usedEras as |era|}}
                  <td class="flex-auto padding-small">
                    {{#if (lookup ../eras era.value)}}
                      <i class="fa-solid fa-circle" data-tooltip="{{era.label}}"></i>
                    {{else}}
                      <i class="fa-regular fa-circle" data-tooltip="{{era.label}}"></i>
                    {{/if}}
                  </td>
                {{/each}}
                <td class="padding-small">{{priority}}</td>
                <td class="padding-small">{{lang}}</td>
                <td class="padding-small">{{{link}}}</td>
                <td class="padding-small">{{{folder}}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </details>
    </div>
    <div class="form-group">
      <label>{{localize 'CoC7.CoCIDFlag.foundry-id'}}:</label>
      <div class="form-value flex-row-gapped">
        <input type="text" value="{{document.id}}" readonly>
        <span class="flex-auto">
          <a data-tooltip="CoC7.CopyToClipboard" class="control copy-to-clipboard"><i class="fa-solid fa-copy"></i></a>
        </span>
      </div>
    </div>
    <div class="form-group">
      <label>{{localize 'CoC7.CoCIDFlag.foundry-uuid'}}:</label>
      <div class="form-value flex-row-gapped">
        <input type="text" value="{{document.uuid}}" readonly>
        <span class="flex-auto">
          <a data-tooltip="CoC7.CopyToClipboard" class="control copy-to-clipboard"><i class="fa-solid fa-copy"></i></a>
        </span>
      </div>
    </div>
    {{#if id}}
      <div class="form-group">
        <label>{{localize 'CoC7.CoCIDFlag.key'}}:</label>
        <div class="form-value flex-row-gapped">
          <input type="text" value="{{id}}" readonly>
          <span class="flex-auto">
            <a data-tooltip="CoC7.CopyToClipboard" class="control copy-to-clipboard"><i class="fa-solid fa-copy"></i></a>
          </span>
        </div>
      </div>
    {{/if}}
    <div class="form-group">
      <label>{{localize 'CoC7.CoCIDFlag.get-this-document'}}:</label>
      <div class="form-value flex-row-gapped">
        <input type="text" value="await fromUuid('{{document.uuid}}')" readonly>
        <span class="flex-auto">
          <a data-tooltip="CoC7.CopyToClipboard" class="control copy-to-clipboard"><i class="fa-solid fa-copy"></i></a>
        </span>
      </div>
    </div>
    {{#if id}}
      <div class="form-group">
        <label>{{localize 'CoC7.CoCIDFlag.get-document-like-this'}}:</label>
        <div class="form-value flex-row-gapped">
          <input type="text" value="await game.CoC7.cocid.fromCoCID('{{id}}', '{{lang}}')" readonly>
          <span class="flex-auto">
            <a data-tooltip="CoC7.CopyToClipboard" class="control copy-to-clipboard"><i class="fa-solid fa-copy"></i></a>
          </span>
        </div>
      </div>
    {{/if}}
  </fieldset>
</section>