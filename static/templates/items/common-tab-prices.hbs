<section class="tab prices flexcol scrollable legend-fieldset {{tab.cssClass}}" data-group="primary" data-tab="prices">
  {{#if tabs.prices}}
    <fieldset class="flexcol">
      <legend>{{localize 'CoC7.EraAvailability'}}</legend>
      <div class="form-group toggle-row">
        <div class="form-value toggle-attributes toggle-smaller flexrow" data-set="eras">
          {{#each _eras as |row|}}
            <button class="toggle-switch{{#if ../useEraIcons}} as-icon{{/if}}{{#if row.isEnabled}} switched-on{{/if}}" data-property="{{row.value}}"{{#if ../useEraIcons}} data-tooltip="{{row.label}}"{{/if}}>{{#if ../useEraIcons}}<i class="{{row.icon}}"></i>{{else}}{{row.label}}{{/if}}</button>
          {{/each}}
        </div>
      </div>
      <div class="columns flexrow flex-none">
        {{#each _eras as |era|}}
          {{#if era.isEnabled}}
            <div class="column-double flexrow">
              <label class="flex-single">{{era.label}}:</label>
              <input class="small" type="text" name="system.price.{{era.value}}" value="{{era.price}}" placeholder="0" />
            </div>
          {{/if}}
        {{/each}}
      </div>
    </fieldset>
  {{/if}}
</section>