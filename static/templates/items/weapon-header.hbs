<div class="flexrow item-header">
  <div class="flexcol">
    <div class="flexrow">
      <input type="text" name="name" value="{{document.name}}" placeholder="{{localize 'CoC7.Name'}}" />
      <div class="flexrow flex-double">
        {{#if document.isEmbedded}}
          <select name="system.skill.main.id" class="flex-single">
            {{#unless document.system.isSkillSet}}
              <option></option>
            {{/unless}}
            {{selectOptions weaponSkillGroups selected=document.system.skill.main.id localize=false}}
          </select>
          {{#if usesAlternateSkill}}
            <select name="system.skill.alternativ.id" class="flex-single">
              {{#unless document.system.isAlternativeSkillSet}}
                <option></option>
              {{/unless}}
              {{selectOptions weaponSkillGroups selected=document.system.skill.alternativ.id localize=false}}
            </select>
          {{/if}}
        {{else}}
          <input class="flex-single" type="text" name="system.skill.main.name" value="{{document.system.skill.main.name}}" placeholder="{{localize 'CoC7.WeaponSkillMain'}}" />
          {{#if usesAlternateSkill}}
            <input class="flex-single" type="text" name="system.skill.alternativ.name" value="{{document.system.skill.alternativ.name}}" placeholder="{{localize 'CoC7.WeaponSkillAlt'}}" />
          {{/if}}
        {{/if}}
      </div>
    </div>
    <div class="flexrow">
      {{#if document.system.properties.rngd}}
        <div class="flexrow">
          <label>{{localize 'CoC7.WeaponRange'}} (yd):</label>
          <input type="text" name="system.range.normal.value" value="{{document.system.range.normal.value}}" placeholder="{{localize 'CoC7.rangeCombatCard.BaseRangeShort'}}" />
          {{#if document.system.properties.shotgun}}
            <input type="text" name="system.range.long.value" value="{{document.system.range.long.value}}" placeholder="{{localize 'CoC7.rangeCombatCard.LongRangeShort'}}" />
            <input type="text" name="system.range.extreme.value" value="{{document.system.range.extreme.value}}" placeholder="{{localize 'CoC7.rangeCombatCard.ExtremeRangeShort'}}" />
          {{/if}}
        </div>
        <div class="flexrow">
          <label>{{localize 'CoC7.WeaponDamage'}}:</label>
          <input type="text" name="system.range.normal.damage" value="{{document.system.range.normal.damage}}" placeholder="0" />
          {{#if document.system.properties.shotgun}}
            <input type="text" name="system.range.long.damage" value="{{document.system.range.long.damage}}" placeholder="0" />
            <input type="text" name="system.range.extreme.damage" value="{{document.system.range.extreme.damage}}" placeholder="0" />
          {{/if}}
        </div>
      {{else}}
        <div class="flexrow">
          <label>{{localize 'CoC7.WeaponTouch'}}</label>
        </div>
        <div class="flexrow">
          <label>{{localize 'CoC7.WeaponDamage'}}:</label>
          <input type="text" name="system.range.normal.damage" value="{{document.system.range.normal.damage}}" placeholder="0" />
        </div>
      {{/if}}
    </div>
    <div class="toggle-row flexrow">
      <div class="toggle-attributes flexrow" data-set="properties">
        {{#each _properties as |row|}}
          <button class="toggle-switch{{#if row.isEnabled}} switched-on{{/if}}" data-property="{{row.value}}"{{#if row.tooltip}} data-tooltip="{{row.tooltip}}"{{/if}}>{{localize row.label}}</button>
        {{/each}}
      </div>
    </div>
  </div>
  <img class="profile-img" src="{{document.img}}" data-action="editImage" data-edit="img" />
</div>