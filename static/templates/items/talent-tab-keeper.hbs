<section class="tab keeper flexcol filled-box {{tab.cssClass}}" data-group="primary" data-tab="keeper">
  {{#if tabs.keeper}}
    <fieldset class="flexrow">
      <legend>{{localize 'CoC7.UsableBy'}}</legend>
      <div class="toggle-row flexrow">
        <div class="toggle-attributes flexrow" data-set="usable">
          {{#each _usable as |row|}}
            <button class="toggle-switch{{#if row.isEnabled}} switched-on{{/if}}" data-property="{{row.value}}"{{#if row.tooltip}} data-tooltip="{{row.tooltip}}"{{/if}}>{{localize row.label}}</button>
          {{/each}}
        </div>
      </div>
    </fieldset>
    <fieldset class="flexcol flex-single">
      <prose-mirror name="system.description.keeper" value="{{document.system.description.keeper}}" data-document-uuid="{{document.uuid}}" toggled>{{{enrichedDescriptionKeeper}}}</prose-mirror>
    </fieldset>
  {{/if}}
</section>