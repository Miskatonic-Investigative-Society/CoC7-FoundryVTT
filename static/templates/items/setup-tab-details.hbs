<section class="tab details flexcol scrollable {{tab.cssClass}}" data-group="primary" data-tab="details">
  {{#if tabs.details}}
    <fieldset class="flexcol">
      <div class="form-group flexrow">
        <label class="flex-single">{{localize 'CoC7.Characteristics'}}</label>
        <div class="form-value toggle-attributes toggle-single-attribute" data-set="">
          <button class="toggle-switch{{#if document.system.enableCharacterisitics}} switched-on{{/if}}" data-property="enableCharacterisitics">{{localize 'CoC7.EnableCharacteristics'}}</button>
        </div>
      </div>
    </fieldset>
    <fieldset class="flexcol">
      <legend>{{localize 'CoC7.Eras'}}</legend>
      <div class="form-group toggle-row">
        <div class="form-value toggle-attributes toggle-smaller flexrow" data-set="eras">
          {{#each _eras as |row|}}
            <button class="toggle-switch{{#if ../useEraIcons}} as-icon{{/if}}{{#if row.isEnabled}} switched-on{{/if}}" data-property="{{row.value}}"{{#if ../useEraIcons}} data-tooltip="{{row.label}}"{{/if}}>{{#if ../useEraIcons}}<i class="{{row.icon}}"></i>{{else}}{{row.label}}{{/if}}</button>
          {{/each}}
        </div>
      </div>
    </fieldset>
    <fieldset class="flexcol">
      <legend>{{localize 'CoC7.MonetaryTitle'}}</legend>
      <div class="form-group flexrow">
        <label class="flex-single">{{localize 'CoC7.MonetaryFormatTitle'}}</label>
        <div class="form-value">
          <select name="system.monetary.format">
            {{selectOptions _monetaryFormats selected=document.system.monetary.format localize=true}}
          </select>
        </div>
      </div>
      {{#if showCurrencySymbol}}
        <div class="form-group flexrow">
          <label class="flex-single">{{localize 'CoC7.MonetarySymbol'}}</label>
          <div class="form-value">
            <input type="text" name="system.monetary.symbol" value="{{document.system.monetary.symbol}}" />
          </div>
        </div>
      {{/if}}
      <div class="flexrow">
        <div></div>
        <div class="item-controls">
          <a class="item-control" data-action="monetary-add"><i class="fa-regular fa-plus-circle fa-fw"></i></a>
        </div>
      </div>
      {{#each monetary as |row index|}}
        <div class="form-group flexrow tiny-monetary" data-index="{{index}}">
          <input name="system.monetary.values.{{index}}.name" value="{{localize row.name}}" type="text" placeholder="{{localize 'CoC7.Name'}}">
          <input name="system.monetary.values.{{index}}.min" value="{{row.min}}" class="cash-assets-range" type="number" placeholder="{{localize 'CoC7.MonetaryCreditRatingMin'}}">
          <input name="system.monetary.values.{{index}}.max" value="{{row.max}}" class="cash-assets-range" type="number" placeholder="{{localize 'CoC7.MonetaryCreditRatingMax'}}" readonly="readonly">
          <select name="system.monetary.values.{{index}}.cashType" class="cash-assets-type">
            {{selectOptions ../_monetaryTypes selected=row.cashType localize=true}}
          </select>
          <input name="system.monetary.values.{{index}}.cashValue" value="{{row.cashValue}}" type="number" placeholder="{{localize 'CoC7.MonetaryValueCash'}}">
          <select name="system.monetary.values.{{index}}.assetsType" class="cash-assets-type">
            {{selectOptions ../_monetaryTypes selected=row.assetsType localize=true}}
          </select>
          <input name="system.monetary.values.{{index}}.assetsValue" value="{{row.assetsValue}}" type="number" placeholder="{{localize 'CoC7.MonetaryValueAssets'}}">
          <select name="system.monetary.values.{{index}}.spendingType" class="cash-assets-type">
            {{selectOptions ../_monetaryTypes selected=row.spendingType localize=true}}
          </select>
          <input name="system.monetary.values.{{index}}.spendingValue" value="{{row.spendingValue}}" type="number" placeholder="{{localize 'CoC7.MonetaryValueSpendingLevel'}}">
          <div class="item-controls">
            <a class="item-control" data-action="monetary-remove"><i class="fa-regular fa-minus-circle fa-fw"></i></a>
          </div>
        </div>
      {{/each}}
    </fieldset>
    {{#if oneBlockBackStory}}
      <fieldset class="flexcol flex-single">
        <legend>{{localize 'CoC7.Background'}}</legend>
        <prose-mirror name="system.backstory" value="{{document.system.backstory}}" data-document-uuid="{{document.uuid}}" toggled>{{{enrichedBackstory}}}</prose-mirror>
      </fieldset>
    {{else}}
      <fieldset class="flexcol">
        <legend>{{localize 'CoC7.BioSections'}}</legend>
        <div class="flexrow">
          <div></div>
          <div class="item-controls">
            <a class="item-control" data-action="biography-add"><i class="fa-regular fa-plus-circle fa-fw"></i></a>
          </div>
        </div>
        {{#each bioSections as |row index|}}
          <div class="bio-section flexrow" data-index="{{index}}" draggable="true">
            <div class="item-controls allow-drag">
              <i class="fa-solid fa-bars"></i>
            </div>
            <input type="text" name="system.bioSections.{{index}}" value="{{localize row.title}}" placeholder="{{localize 'CoC7.BioSectionName'}}" />
            <div class="item-controls">
              <a class="item-control" data-action="biography-remove" data-tooltip="CoC7.BackgroundDeleteSection"><i class="fa-regular fa-minus-circle fa-fw"></i></a>
            </div>
          </div>
        {{/each}}
      </fieldset>
    {{/if}}
    <fieldset class="flexcol drop-item flex-single">
      <legend>{{localize 'CoC7.Items'}}</legend>
      <ul class="item-list">
        {{#if itemsListEmpty}}
          <li class="item">
            <label>{{localize 'CoC7.EmptyItemList'}}</label>
          </li>
        {{else}}
          {{#each otherItems as |item|}}
            <li class="item" data-uuid="{{item.uuid}}" data-id="{{item._id}}" data-cocid="{{item.flags.CoC7.cocidFlag.id}}">
              <div class="summary">{{item.name}} ({{item.type}})</div>
              <div class="item-controls">
                <a class="item-control" data-action="item-delete" data-tooltip="CoC7.DeleteItem"><i class="fa-solid fa-trash fa-fw"></i></a>
              </div>
            </li>
          {{/each}}
        {{/if}}
      </ul>
    </fieldset>
  {{/if}}
</section>