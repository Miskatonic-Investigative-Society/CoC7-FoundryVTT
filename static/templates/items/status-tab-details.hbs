<section class="tab details flexcol filled-box legend-fieldset {{tab.cssClass}}" data-group="primary" data-tab="details">
  {{#if tabs.details}}
    <fieldset class="flexrow">
      <legend>{{localize 'CoC7.InsanityType'}}</legend>
      <div class="toggle-row flexrow">
        <div class="toggle-attributes flexrow" data-set="type">
          {{#each _types as |row|}}
            <button class="toggle-switch{{#if row.isEnabled}} switched-on{{/if}}" data-property="{{row.value}}"{{#if row.tooltip}} data-tooltip="{{row.tooltip}}"{{/if}}>{{localize row.label}}</button>
          {{/each}}
        </div>
      </div>
    </fieldset>
    <fieldset class="flexcol flex-single">
      <legend>{{localize 'CoC7.Notes'}}</legend>
      <prose-mirror name="system.description.notes" value="{{document.system.description.notes}}" data-document-uuid="{{document.uuid}}" toggled>{{{enrichedDescriptionNotes}}}</prose-mirror>
    </fieldset>
  {{/if}}
</section>