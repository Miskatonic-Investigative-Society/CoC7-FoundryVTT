<section class="tab skills flexcol scrollable {{tab.cssClass}}" data-group="primary" data-tab="skills">
  {{#if tabs.skills}}
    <fieldset class="flexcol">
      <div class="form-group flexrow">
        <label class="flex-single">{{localize 'CoC7.BonusPoints'}}</label>
        <div class="form-value">
          <input type="text" name="system.points" value="{{document.system.points}}" placeholder="{{localize 'CoC7.Value'}}" />
        </div>
      </div>
    </fieldset>
    <fieldset class="flexcol drop-item flex-single">
      <legend>{{localize 'CoC7.CommonSkills'}}</legend>
      <ul class="item-list">
        {{#if skillListEmpty}}
          <li class="item">
            <label>{{localize 'CoC7.EmptySkillList'}}</label>
          </li>
        {{else}}
          {{#each skills as |item|}}
            <li class="item" data-uuid="{{item.uuid}}" data-id="{{item._id}}" data-cocid="{{item.flags.CoC7.cocidFlag.id}}">
              <div class="summary">{{item.name}} ({{item.system.base}}%)</div>
              <div class="item-controls">
                <a class="item-control" data-action="item-delete" data-tooltip="CoC7.DeleteItem"><i class="fa-solid fa-trash fa-fw"></i></a>
              </div>
            </li>
          {{/each}}
        {{/if}}
      </ul>
    </fieldset>
    <fieldset class="flexcol">
      <legend>{{localize 'CoC7.OptionSkills'}}</legend>
      <div class="flexrow">
        <div></div>
        <div class="item-controls">
          <a class="item-control" data-action="group-add"><i class="fa-regular fa-plus-circle fa-fw"></i></a>
        </div>
      </div>
      {{#each groups as |group index|}}
        <fieldset class="skill-group flexcol drop-item" data-group="{{index}}">
          <div class="form-group flexrow">
            <label class="flex-single">{{localize 'CoC7.Choose'}}</label>
            <input class="small" type="text" name="system.groups.{{index}}.options" value="{{group.options}}" placeholder="{{localize 'CoC7.ChoiceNumber'}}" />
            <div class="item-controls">
              <a class="item-control" data-action="group-remove"><i class="fa-regular fa-minus-circle fa-fw"></i></a>
            </div>
          </div>
          <ul class="item-list">
            {{#if group.isEmpty}}
              <li class="item">
                <label>{{localize 'CoC7.EmptySkillList'}}</label>
              </li>
            {{else}}
              {{#each group.skills as |item|}}
                <li class="item" data-uuid="{{item.uuid}}" data-id="{{item._id}}" data-cocid="{{item.flags.CoC7.cocidFlag.id}}">
                  <div class="summary">{{item.name}} ({{item.system.base}}%)</div>
                  <div class="item-controls">
                    <a class="item-control" data-action="item-delete" data-tooltip="CoC7.DeleteItem"><i class="fa-solid fa-trash fa-fw"></i></a>
                  </div>
                </li>
              {{/each}}
            {{/if}}
          </ul>
        </fieldset>
      {{/each}}
    </fieldset>
  {{/if}}
</section>