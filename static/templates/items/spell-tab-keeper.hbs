<section class="tab keeper flexcol scrollable {{tab.cssClass}}" data-group="primary" data-tab="keeper">
  {{#if tabs.keeper}}
    <fieldset class="flexcol flex-single">
      <prose-mirror name="system.description.keeper" value="{{document.system.description.keeper}}" data-document-uuid="{{document.uuid}}" toggled>{{{enrichedDescriptionKeeper}}}</prose-mirror>
    </fieldset>
    {{#if showLegacySpellCosts}}
      <fieldset class="flexrow">
        <legend>{{localize 'CoC7.Spell.Legacy.Label'}}</legend>
        <p class="flex-full">{{localize 'CoC7.Spell.Legacy.Hint'}}</p>
        <div class="columns flexrow">
          <div class="flexrow column-double">
            <label class="flex-single">{{localize 'CoC7.SanityCost'}}:</label>
            <input type="text" name="system.costs.sanity" value="{{document.system.costs.sanity}}" />
          </div>
          <div class="flexrow column-double">
            <label class="flex-single">{{localize 'CoC7.HitPointsCost'}}:</label>
            <input type="text" name="system.costs.hitPoints" value="{{document.system.costs.hitPoints}}" />
          </div>
          <div class="flexrow column-double">
            <label class="flex-single">{{localize 'CoC7.PowerCost'}}:</label>
            <input type="text" name="system.costs.power" value="{{document.system.costs.power}}" />
          </div>
          <div class="flexrow column-double">
            <label class="flex-single">{{localize 'CoC7.MagicPointsCost'}}:</label>
            <input type="text" name="system.costs.magicPoints" value="{{document.system.costs.magicPoints}}" />
          </div>
          <div class="flexrow column-single">
            <label class="as-column-quarter">{{localize 'CoC7.OtherCosts'}}:</label>
            <input type="text" name="system.costs.others" value="{{document.system.costs.others}}" />
          </div>
        </div>
      </fieldset>
    {{/if}}
  {{/if}}
</section>