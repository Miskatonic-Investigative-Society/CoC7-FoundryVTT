<section class="tab details flexcol scrollable legend-fieldset {{tab.cssClass}}" data-group="primary" data-tab="details">
  {{#if tabs.details}}
    <fieldset class="flexrow">
      <legend>{{localize 'CoC7.SpellType'}}</legend>
      <div class="toggle-row flexrow">
        <div class="toggle-attributes flexrow" data-set="type">
          {{#each _types as |row|}}
            <button class="toggle-switch{{#if row.isEnabled}} switched-on{{/if}}" data-property="{{row.value}}"{{#if row.tooltip}} data-tooltip="{{row.tooltip}}"{{/if}}>{{localize row.label}}</button>
          {{/each}}
        </div>
      </div>
    </fieldset>
    <fieldset class="flexcol">
      <legend>{{localize 'CoC7.SpellCosts'}}</legend>
      <div class="adjustable-listbox flexcol">
        {{#each document.system.costList as |row index|}}
          <div class="adjustable-list-item" data-index="{{index}}" draggable="true">
            <div class="item-controls allow-drag">
              <i class="fa-solid fa-bars"></i>
            </div>
            <div class="adjustable-item-block flexcol" draggable="true">
              <div class="adjustable-item-row">
                <select name="system.costList.{{index}}.type">{{selectOptions ../_costListTypes selected=row.type}}</select>
                <label>{{localize 'CoC7.Spell.Costs.If'}}</label>
                <input type="text" class="small" name="system.costList.{{index}}.if" value="{{row.if}}" placeholder="{{localize 'CoC7.Spell.Costs.VariablePlaceholder'}}">
              </div>
              <div class="adjustable-item-row">
                {{#if (or (eq row.type 'promptRequireNumber') (eq row.type 'additionalCasterPromptRequireNumber') (eq row.type 'promptToggleButton'))}}
                  <label>{{localize 'CoC7.Spell.Costs.PromptName'}}</label>
                  <div><input type="text" name="system.costList.{{index}}.config.prompt" value="{{row.config.prompt}}"></div>
                {{else if (or (eq row.type 'casterCost') (eq row.type 'additionalCasterCost'))}}
                  <label>{{localize 'CoC7.Spell.Costs.Modify'}}</label>
                  <div><select name="system.costList.{{index}}.config.modify">{{selectOptions ../_costListCosts selected=row.config.modify}}</select></div>
                {{else if (eq row.type 'castingTime')}}
                  <label>{{localize 'CoC7.Spell.Costs.Text'}}</label>
                  <div><input type="text" name="system.costList.{{index}}.config.value" value="{{row.config.value}}"></div>
                {{else if (eq row.type 'additionalCasterPromptAdd')}}
                  <label>{{localize 'CoC7.Spell.Costs.PromptName'}}</label>
                  <div><input type="text" name="system.costList.{{index}}.config.prompt" value="{{row.config.prompt}}"></div>
                {{else if (eq row.type 'setVariable')}}
                  <label>{{localize 'CoC7.Spell.Costs.VariableName'}}</label>
                  <div><input type="text" name="system.costList.{{index}}.config.variable" value="{{row.config.variable}}" placeholder="{{localize 'CoC7.Spell.Costs.VariablePlaceholder'}}"></div>
                  <label>{{localize 'CoC7.Spell.Costs.Value'}}</label>
                  <div><input type="text" name="system.costList.{{index}}.config.value" value="{{row.config.value}}"></div>
                {{else if (eq row.type 'showVariable')}}
                  <label>{{localize 'CoC7.Spell.Costs.PromptName'}}</label>
                  <div><input type="text" name="system.costList.{{index}}.config.prompt" value="{{row.config.prompt}}"></div>
                {{else if (eq row.type 'promptShowText')}}
                  <label>{{localize 'CoC7.Spell.Costs.PromptName'}}</label>
                  <div><input type="text" name="system.costList.{{index}}.config.prompt" value="{{row.config.prompt}}"></div>
                {{else if (eq row.type 'additionalInformation')}}
                  <label>{{localize 'CoC7.Spell.Costs.Text'}}</label>
                  <div><input type="text" name="system.costList.{{index}}.config.prompt" value="{{row.config.prompt}}"></div>
                {{/if}}
              </div>
              <div class="adjustable-item-row">
                {{#if (or (eq row.type 'promptRequireNumber') (eq row.type 'additionalCasterPromptRequireNumber') (eq row.type 'promptToggleButton'))}}
                  <label>{{localize 'CoC7.Spell.Costs.VariableName'}}</label>
                  <div><input type="text" name="system.costList.{{index}}.config.variable" value="{{row.config.variable}}" placeholder="{{localize 'CoC7.Spell.Costs.VariablePlaceholder'}}"></div>
                {{else if (or (eq row.type 'casterCost') (eq row.type 'additionalCasterCost'))}}
                  <label>{{localize 'CoC7.Spell.Costs.Value'}}</label>
                  <div><input type="text" name="system.costList.{{index}}.config.value" value="{{row.config.value}}"></div>
                {{else if (eq row.type 'additionalCasterPromptAdd')}}
                  <label>{{localize 'CoC7.Spell.Costs.VariableName'}}</label>
                  <div><input type="text" name="system.costList.{{index}}.config.variable" value="{{row.config.variable}}" placeholder="{{localize 'CoC7.Spell.Costs.VariablePlaceholder'}}"></div>
                  <label>{{localize 'CoC7.Spell.Costs.GroupSize'}}</label>
                  <div><input type="text" name="system.costList.{{index}}.config.step" value="{{row.config.step}}"></div>
                  <label>{{localize 'CoC7.Spell.Costs.Minimum'}}</label>
                  <div><input type="text" name="system.costList.{{index}}.config.min" value="{{row.config.min}}"></div>
                {{else if (eq row.type 'showVariable')}}
                  <label>{{localize 'CoC7.Spell.Costs.VariableName'}}</label>
                  <div><input type="text" name="system.costList.{{index}}.config.variable" value="{{row.config.variable}}" placeholder="{{localize 'CoC7.Spell.Costs.VariablePlaceholder'}}"></div>
                {{/if}}
              </div>
            </div>
            <div class="item-controls item-controls-column" draggable="true">
              <a class="item-control" data-action="cost-list-before" data-tooltip="CoC7.Spell.Costs.AddSectionBefore"><i class="fa-regular fa-plus-circle fa-fw"></i></a>
              <a class="item-control" data-action="cost-list-remove" data-tooltip="CoC7.Spell.Costs.DeleteSection"><i class="fa-regular fa-minus-circle fa-fw"></i></a>
            </div>
          </div>
        {{/each}}
      </div>
      <div class="flexrow">
        <div></div>
        <div class="item-controls">
          <a class="item-control" data-action="cost-list-add"><i class="fa-regular fa-plus-circle fa-fw"></i></a>
        </div>
      </div>
    </fieldset>
    <fieldset class="flexcol flex-single">
      <legend>{{localize 'CoC7.AlternativeNames'}}</legend>
      <prose-mirror name="system.description.alternativeNames" value="{{document.system.description.alternativeNames}}" data-document-uuid="{{document.uuid}}" toggled>{{{enrichedDescriptionAlternativeNames}}}</prose-mirror>
    </fieldset>
  {{/if}}
</section>