<section class="tab description flexcol filled-box {{tab.cssClass}}" data-group="primary" data-tab="description">
  {{#if tabs.description}}
    <div class="flexrow flex-single tall-columns">
      <div class="properties-list">
        {{#each _properties}}
          <div class="property">{{localize this}}</div>
        {{/each}}
      </div>
      <fieldset class="flexcol flex-single">
        <prose-mirror name="system.description.value" value="{{document.system.description.value}}" data-document-uuid="{{document.uuid}}" toggled>{{{enrichedDescriptionValue}}}</prose-mirror>
      </fieldset>
    </div>
  {{/if}}
</section>