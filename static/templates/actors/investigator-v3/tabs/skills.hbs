<section class="tab skills {{tabs.skills.cssClass}}" data-group="primary" data-tab="skills">
  <header class="tab-header">
    <div class="item-controls">
      {{#unless document.system.flags.locked}}
        <a class="item-control"><i class="fa-regular fa-plus-circle fa-fw"></i></a>
      {{/unless}}
      <a class="item-control"><i class="fa-solid fa-sort-amount-down fa-fw"></i></a>
      <a class="item-control"><i class="fa-solid fa-toggle-off fa-fw"></i></a>
    </div>
    <h2 class="tab-heading">{{localize 'CoC7.Skills'}}</h2>
    <div class="item-controls">
      {{#unless document.system.flags.locked}}
        <a class="item-control" data-action="item-add" data-type="skill" data-tooltip="CoC7.AddSkill"><i class="fa-regular fa-plus-circle fa-fw"></i></a>
      {{/unless}}
      <a class="item-control" data-action="toggle-flag" data-toggle-flag="skillListMode" data-tooltip="{{#if skillListMode}}CoC7.SortBySkillName{{else}}CoC7.SortBySkillValue{{/if}}"><i class="fa-solid {{#if skillListMode}}fa-sort-alpha-down{{else}}fa-sort-amount-down{{/if}} fa-fw"></i></a>
      <a class="item-control" data-action="toggle-flag" data-toggle-flag="skillShowUncommon" data-tooltip="{{#if skillShowUncommon}}CoC7.UncommonSkillsShow{{else}}CoC7.UncommonSkillsHide{{/if}}"><i class="fa-solid {{#if skillShowUncommon}}fa-toggle-on{{else}}fa-toggle-off{{/if}} fa-fw"></i></a>
    </div>
  </header>
  {{#if skillListEmpty}}
    <h4 class="coc7-warning">{{localize 'CoC7.EmptyCharacterSkillList'}}</h4>
  {{/if}}

  <ul class="item-list{{#if showPartValues}} show-part-values{{/if}}">
    {{#if skillListMode}}
      {{#each skillsByValue as |skill|}}
        <li class="item skill" data-item-uuid="{{skill.uuid}}">
          <div class="item-image" style="background-image: url('{{skill.img}}')"></div>
          {{#if ../document.system.flags.locked}}
            <div class="item-name skill-name rollable" data-name-tooltip="{{skill.name}}" data-value-tooltip="{{skill.system.value}}">{{skill.name}}</div>
            <div class="skill-value item-score">{{skill.system.value}}</div>
            <div class="skill-calc">({{calcHard skill.system.value}}/{{calcExtreme skill.system.value}})</div>
            <div class="item-controls flex-auto">
              {{#unless skill.system.properties.noxpgain}}
                {{#if skill.system.flags.developement}}
                  <a class="item-control active" data-action="development-flag" data-tooltip="{{localize 'CoC7.ToolTipSkillFlagToggle' status=(localize 'CoC7.ToolTipSkillFlagged')}}"><i class="fa-solid fa-circle-check fa-fw"></i></a>
                {{else}}
                  <a class="item-control" data-action="development-flag" data-tooltip="{{localize 'CoC7.ToolTipSkillFlagToggle' status=(localize 'CoC7.ToolTipSkillUnflagged')}}"><i class="fa-light fa-circle fa-fw"></i></a>
                {{/if}}
              {{else}}
                <a class="item-control"><i class="fa-light fa-circle fa-fw"></i></a>
              {{/unless}}
              <a class="item-control" data-action="item-popup" data-tooltip="CoC7.SkillDetail"><i class="fa-solid fa-info-circle fa-fw"></i></a>
            </div>
          {{else}}
            <div class="item-name">
              <input class="skill-name" type="text" value="{{#if skill.system.properties.special}}{{skill.system.skillName}}{{else}}{{skill.name}}{{/if}}">
            </div>
            <input class="npc-skill-score" type="text" value="{{skill.system.valueUnmodified}}">
            <div class="item-controls">
              <a class="item-control" data-action="item-edit" data-tooltip="CoC7.EditSkill"><i class="fa-solid fa-edit fa-fw"></i></a>
              <a class="item-control" data-action="item-delete" data-tooltip="CoC7.DeleteSkill"><i class="fa-solid fa-trash fa-fw"></i></a>
            </div>
          {{/if}}
        </li>
      {{/each}}
    {{else}}
      {{#each skillList as |skill|}}
        {{#if skill.isSpecialization}}
          <li class="specialization-header">{{skill.name}}</li>
        {{else}}
          <li class="item skill{{#if skill.system.properties.special}} specialization{{/if}}" data-item-uuid="{{skill.uuid}}">
            <div class="item-image" style="background-image: url('{{skill.img}}')"></div>
            {{#if ../document.system.flags.locked}}
              <div class="item-name skill-name rollable" data-name-tooltip="{{skill.name}}" data-value-tooltip="{{skill.system.value}}">{{#if skill.system.properties.special}}{{skill.system.skillName}}{{else}}{{skill.name}}{{/if}}</div>
              <div class="skill-value item-score">{{skill.system.value}}</div>
              <div class="skill-calc">({{calcHard skill.system.value}}/{{calcExtreme skill.system.value}})</div>
              <div class="item-controls flex-auto">
                {{#unless skill.system.properties.noxpgain}}
                  {{#if skill.system.flags.developement}}
                    <a class="item-control active" data-action="development-flag" data-tooltip="{{localize 'CoC7.ToolTipSkillFlagToggle' status=(localize 'CoC7.ToolTipSkillFlagged')}}"><i class="fa-solid fa-circle-check fa-fw"></i></a>
                  {{else}}
                    <a class="item-control" data-action="development-flag" data-tooltip="{{localize 'CoC7.ToolTipSkillFlagToggle' status=(localize 'CoC7.ToolTipSkillUnflagged')}}"><i class="fa-light fa-circle fa-fw"></i></a>
                  {{/if}}
                {{else}}
                  <a class="item-control"><i class="fa-light fa-circle fa-fw"></i></a>
                {{/unless}}
                <a class="item-control" data-action="item-popup" data-tooltip="CoC7.SkillDetail"><i class="fa-solid fa-info-circle fa-fw"></i></a>
              </div>
            {{else}}
              <div class="item-name">
                <input class="skill-name" type="text" value="{{#if skill.system.properties.special}}{{skill.system.skillName}}{{else}}{{skill.name}}{{/if}}">
              </div>
              <input class="npc-skill-score" type="text" value="{{skill.system.valueUnmodified}}">
              <div class="item-controls">
                <a class="item-control" data-action="item-edit" data-tooltip="CoC7.EditSkill"><i class="fa-solid fa-edit fa-fw"></i></a>
                <a class="item-control" data-action="item-delete" data-tooltip="CoC7.DeleteSkill"><i class="fa-solid fa-trash fa-fw"></i></a>
              </div>
            {{/if}}
          </li>
        {{/if}}
      {{/each}}
    {{/if}}
  </ul>
</section>