<ul class="item-list effects-list">
  {{#each effects as |category sid|}}
    {{#unless category.hidden}}
      <li class="items-header" data-effect-type="{{category.type}}">
        <h4 class="section-heading">{{localize category.label}}</h4>
        <div class="effect-source">{{localize 'CoC7.Source'}}</div>
        <div class="effect-duration">{{localize 'CoC7.Duration'}}</div>
        <div class="item-controls">
          {{#if (and @root.editable (ne 'status' sid))}}
            <a class="effect-control" data-action="create" data-tooltip="CoC7.Create">
              <i class="fa-regular fa-plus-circle"></i> {{localize 'CoC7.Add'}}
            </a>
          {{/if}}
        </div>
      </li>
      {{#if category.info}}
        <li>
          <ul class="info">
            {{#each category.info}}
              <li class="notification info">{{this}}</li>
            {{/each}}
          </ul>
        </li>
      {{/if}}
      {{#each category.effects as |effect|}}
        <li class="item" data-effect-uuid="{{effect.uuid}}">
          <div class="effect-identifier" data-tooltip="{{effect.readable}}">
            <div class="item-image" style="background-image: url('{{effect.img}}')"></div>
            <div class="item-name effect-name">{{effect.name}}</div>
          </div>
          <div class="effect-source">{{{effect.source}}}</div>
          <div class="effect-duration">{{effect.duration}}</div>
          <div class="item-controls">
            {{#if @root.editable}}
              <a class="effect-control" data-action="toggle" data-tooltip="{{#if effect.disabled}}CoC7.Enable{{else}}CoC7.Disable{{/if}}">
                <i class="fa-solid{{#if effect.disabled}} fa-check{{else}} fa-times{{/if}} fa-fw"></i>
              </a>
              <a class="effect-control" data-action="edit" data-tooltip="CoC7.Edit">
                <i class="fa-solid fa-edit fa-fw"></i>
              </a>
              <a class="effect-control" data-action="delete" data-tooltip="CoC7.Delete">
                <i class="fa-solid fa-trash fa-fw"></i>
              </a>
            {{/if}}
          </div>
        </li>
      {{/each}}
    {{/unless}}
  {{/each}}
</ul>